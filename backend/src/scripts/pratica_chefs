CREATE TABLE IF NOT EXISTS public.tb_favoritos
(
    id_favorito serial NOT NULL,
    id_usuario serial NOT NULL,
    id_receita serial NOT NULL,
    created_at character varying COLLATE pg_catalog."default" NOT NULL,
    updated_at character varying COLLATE pg_catalog."default" NOT NULL,
    CONSTRAINT tb_favoritos_pkey PRIMARY KEY (id_favorito)
);

CREATE TABLE IF NOT EXISTS public.tb_receita
(
    id_receita serial NOT NULL,
    titulo_receita character varying COLLATE pg_catalog."default" NOT NULL,
    origem_receita character varying COLLATE pg_catalog."default" NOT NULL,
    id_usuario serial NOT NULL,
    url_imagem character varying COLLATE pg_catalog."default" NOT NULL,
    created_at character varying COLLATE pg_catalog."default" NOT NULL,
    updated_at character varying COLLATE pg_catalog."default" NOT NULL,
    CONSTRAINT tb_receita_pkey PRIMARY KEY (id_receita)
);

CREATE TABLE IF NOT EXISTS public.tb_usuario
(
    id_usuario serial NOT NULL,
    nome text COLLATE pg_catalog."default" NOT NULL,
    nome_usuario character varying COLLATE pg_catalog."default" NOT NULL,
    email character varying COLLATE pg_catalog."default" NOT NULL,
    senha integer NOT NULL,
    imagem_usuario character varying COLLATE pg_catalog."default" NOT NULL,
    tipo character varying COLLATE pg_catalog."default" NOT NULL,
    created_at character varying COLLATE pg_catalog."default" NOT NULL,
    updated_at character varying COLLATE pg_catalog."default" NOT NULL,
    CONSTRAINT tb_usuario_pkey PRIMARY KEY (id_usuario)
);

ALTER TABLE IF EXISTS public.tb_favoritos
    ADD CONSTRAINT tb_favoritos_id_receita_fkey FOREIGN KEY (id_receita)
    REFERENCES public.tb_receita (id_receita) MATCH SIMPLE
    ON UPDATE NO ACTION
    ON DELETE NO ACTION
    NOT VALID;


ALTER TABLE IF EXISTS public.tb_favoritos
    ADD CONSTRAINT tb_favoritos_id_usuario_fkey FOREIGN KEY (id_usuario)
    REFERENCES public.tb_usuario (id_usuario) MATCH SIMPLE
    ON UPDATE NO ACTION
    ON DELETE NO ACTION
    NOT VALID;


ALTER TABLE IF EXISTS public.tb_receita
    ADD CONSTRAINT tb_receita_id_usuario_fkey FOREIGN KEY (id_usuario)
    REFERENCES public.tb_usuario (id_usuario) MATCH SIMPLE
    ON UPDATE NO ACTION
    ON DELETE NO ACTION
    NOT VALID;

